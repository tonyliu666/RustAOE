// The numbers the game plays by.
//
// Read once at startup. Every field is required, and an unknown field is an
// error, so a typo cannot load quietly and do nothing.
//
// Unit and building types are lists: adding a type is adding an entry. Each
// has a unique `name`, which other entries use to refer to it (`trains`), and
// a `sprite`: the SLP ID to draw it with, found in the original game's
// archives in the original's search order. `parts`, when not
// empty, lists the SLPs drawn instead, in order, as `(slp, x, y)`: each at the
// ground point moved x pixels right and y down, placed by its own hotspot, as
// the original draws a graphic's pieces and a building's annexes.
//
// Times are in ticks; the simulation runs at 20 ticks per second.
// Fractions are written `(numerator, denominator)`: `(1, 8)` is one eighth.
// Distances are in tiles.
//
// Costs list only the resources they use: `(food: 50, gold: 20)`; a resource
// left out costs nothing. The villager costs 50 food, as in the original.
// The soldier is the militia at 60 food and 20 gold, as converted by datconv.
// Gather rates and carry capacities are per-resource from the original's job
// units (forager 120, lumberjack 123, gold miner 579, stone miner 124).
(
    units: [
        (
            name: "villager",
            sprite: 1479,
            parts: [],
            icon: 15,               // its button: a frame in interfac.drs 50730
            gathers: true,          // may gather and carry loads
            max_hp: 25,
            speed: (2621, 65536),   // 0.04 tiles per tick: 0.8 tiles per second
            damage: 3,              // melee damage from .dat unit 83
            range: (0, 1),
            attack_cooldown: 40,    // 2 seconds
            radius: (13107, 65536), // 0.2 tiles
            cost: (food: 50),
            train_ticks: 500,       // 25 seconds
        ),
        (
            name: "soldier",
            sprite: 993,           // the militia standing (SPRMN_FN, unit 74)
            parts: [],
            icon: 8,
            gathers: false,
            max_hp: 40,
            speed: (2949, 65536),  // 0.045 tiles per tick: 0.9 tiles per second
            damage: 4,
            range: (0, 1),          // between edges, as in the original: melee
            attack_cooldown: 40,    // 2 seconds
            radius: (13107, 65536), // 0.2 tiles
            cost: (food: 60, gold: 20),
            train_ticks: 420,       // 21 seconds
        ),
    ],
    buildings: [
        (
            name: "town_center",
            // The Dark Age British town centre (unit 109): its graphic's
            // pieces and its three annexes', each placed by its own hotspot.
            sprite: 3596,
            parts: [
                (889, 0, 0), (3596, 0, 0), (4612, 0, 0), (891, 0, 0),
                (3595, 0, 0), (4611, 0, 0), (3594, 0, 0), (4610, 0, 0),
            ],
            icon: 28,               // a frame in interfac.drs 50705
            size: 4,                // footprint, in tiles a side
            max_hp: 2400,
            drop_off: [food, wood, gold, stone],  // what villagers may deposit here
            trains: ["villager"],
        ),
        (
            name: "barracks",
            sprite: 2683,           // the Dark Age British barracks (unit 12)
            parts: [],
            icon: 2,
            size: 3,
            max_hp: 1200,
            drop_off: [],
            trains: ["soldier"],
        ),
        // The drop-off camps, converted from the .dat (units 68, 562, 584).
        // Two tiles a side, 1000 hit points, each taking what its jobs bring.
        (
            name: "mill",
            sprite: 3482,
            parts: [(3483, 0, 0), (3482, 0, 0)],
            icon: 19,
            size: 2,
            max_hp: 1000,
            drop_off: [food],
            trains: [],
        ),
        (
            name: "lumber_camp",
            sprite: 3507,
            parts: [],
            icon: 40,
            size: 2,
            max_hp: 1000,
            drop_off: [wood],
            trains: [],
        ),
        (
            name: "mining_camp",
            sprite: 3495,
            parts: [],
            icon: 39,
            size: 2,
            max_hp: 1000,
            drop_off: [gold, stone],
            trains: [],
        ),
    ],
    // Per-resource gather numbers from datconv (British civ):
    // food (forager 120): 0.31/s -> 65 ticks/unit, carry 10
    // wood (lumberjack 123): 0.39/s -> 51 ticks/unit, carry 10
    // gold (gold miner 579): 0.38/s -> 53 ticks/unit, carry 10
    // stone (stone miner 124): 0.36/s -> 56 ticks/unit, carry 10
    // farm (farmer 259): 0.53/s -> 38 ticks/unit, carry 10
    gather: (
        food: (carry_capacity: 10, ticks_per_unit: 65),
        wood: (carry_capacity: 10, ticks_per_unit: 51),
        gold: (carry_capacity: 10, ticks_per_unit: 53),
        stone: (carry_capacity: 10, ticks_per_unit: 56),
        farm: (carry_capacity: 10, ticks_per_unit: 38),
    ),
)